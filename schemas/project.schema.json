{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xxy2000s/moye/schemas/project.schema.json",
  "title": "Moye Project Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "repository", "workflow", "agent", "tests", "documentation", "artifacts", "privacy"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "project": {
      "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" } }
    },
    "repository": {
      "type": "object", "additionalProperties": false, "required": ["root", "baseRef", "targetRef"],
      "properties": { "root": { "$ref": "#/$defs/path" }, "baseRef": { "type": "string", "minLength": 1 }, "targetRef": { "type": "string", "minLength": 1 } }
    },
    "workflow": {
      "type": "object", "additionalProperties": false, "required": ["profile", "repairBudget", "replanBudget"],
      "properties": { "profile": { "const": "core-v2" }, "repairBudget": { "$ref": "#/$defs/budget" }, "replanBudget": { "$ref": "#/$defs/budget" } }
    },
    "agent": {
      "type": "object", "additionalProperties": false, "required": ["runner", "captureTranscripts"],
      "properties": { "runner": { "enum": ["codex", "claude"] }, "captureTranscripts": { "enum": ["none", "digest_only", "redacted", "full"] } }
    },
    "tests": { "type": "array", "items": { "$ref": "#/$defs/command" } },
    "documentation": {
      "type": "object", "additionalProperties": false, "required": ["policy"],
      "properties": { "policy": { "enum": ["none", "conventional", "moye-doc-graph", "custom"] }, "command": { "$ref": "#/$defs/command" } }
    },
    "artifacts": { "type": "object", "additionalProperties": false, "required": ["root"], "properties": { "root": { "$ref": "#/$defs/path" } } },
    "privacy": { "type": "object", "additionalProperties": false, "required": ["capturePrompts"], "properties": { "capturePrompts": { "type": "boolean" } } }
  },
  "$defs": {
    "budget": { "type": "integer", "minimum": 0, "maximum": 20 },
    "path": { "type": "string", "minLength": 1, "not": { "pattern": "^(?:/|\\\\|[A-Za-z]:|\\.\\.(?:/|$))" } },
    "command": {
      "type": "object", "additionalProperties": false, "required": ["id", "argv", "cwd"],
      "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" }, "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "cwd": { "$ref": "#/$defs/path" } }
    }
  }
}

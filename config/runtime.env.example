# Host bindings remain loopback-only by default.
MOYE_BOARD_BIND_PORT=3000
RESTATE_INGRESS_BIND_PORT=8080
RESTATE_ADMIN_BIND_PORT=9070
RESTATE_NODE_NAME=moye-runtime

# Pin an immutable published image for upgrade/rollback. Local development builds this tag.
MOYE_IMAGE=moye:0.1.0-local
MOYE_PROJECT_ID=moye

# Explicit host paths mounted into the Service container.
MOYE_WORKSPACE_ROOT=./.moye-runtime/workspaces
MOYE_SESSION_SOURCE_ROOT=./.moye-runtime/sessions

# Sensitive model/session content stays disabled unless the operator opts in.
MOYE_OBSERVABILITY_ENABLED=false
MOYE_CAPTURE_USER_PROMPTS=false
MOYE_CAPTURE_ASSISTANT_RESPONSES=false
MOYE_CAPTURE_TOOL_DETAILS=false
MOYE_CAPTURE_TOOL_CONTENT=false
MOYE_CAPTURE_RAW_MODEL_IO=false
